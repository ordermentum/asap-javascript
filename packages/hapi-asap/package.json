{
  "name": "@ordermentum/hapi-asap",
  "version": "2.0.0",
  "main": "build/index.js",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ordermentum/asap-javascript.git",
    "directory": "packages/hapi-asap"
  },
  "files": [
    "build/*"
  ],
  "devDependencies": {
    "@hapi/hapi": "^21.4.4",
    "@ordermentum/asap-test-helpers": "*",
    "@types/chai": "^4.3.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.0.0",
    "@types/sinon": "^10.0.11",
    "@types/supertest": "^2.0.11",
    "chai": "^4.3.6",
    "eslint-config-ordermentum": "^1.0.6",
    "husky": "^7.0.4",
    "joi": "^17.13.3",
    "lint-staged": "^12.3.5",
    "mocha": "^12.0.1",
    "mocha-sinon": "^2.1.2",
    "sinon": "^13.0.1",
    "supertest": "^6.2.2",
    "ts-node": "^10.7.0",
    "ts-node-dev": "^1.1.8",
    "typescript": "^4.9.5"
  },
  "scripts": {
    "build": "rm -rf build && tsc",
    "lint": "eslint '**/*.{ts,js}'",
    "spec": "NODE_ENV=test mocha -r ts-node/register/transpile-only 'test/**/*.{ts,js}'",
    "test": "yarn spec",
    "coverage": "nyc yarn spec",
    "typecheck": "yarn tsc --noEmit"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.0",
    "@ordermentum/asap-core": "*",
    "jsonwebtoken": "^9.0.0"
  },
  "peerDependencies": {
    "@hapi/hapi": ">=20.0.0"
  },
  "nyc": {
    "extends": "@istanbuljs/nyc-config-typescript",
    "all": true,
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "**/*.d.ts",
      "**/build/**"
    ],
    "reporter": [
      "text-summary"
    ]
  }
}
