{
  "name": "@ordermentum/axios-asap",
  "version": "1.0.2",
  "main": "build/index.js",
  "files": [
    "build/*"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ordermentum/asap-javascript.git",
    "directory": "packages/axios-asap"
  },
  "devDependencies": {
    "@ordermentum/asap-test-helpers": "*",
    "@types/chai": "4.3.20",
    "@types/express": "4.17.13",
    "@types/jsonwebtoken": "8.5.8",
    "@types/mocha": "10.0.10",
    "@types/node": "^20.0.0",
    "@types/sinon": "10.0.11",
    "chai": "4.5.0",
    "eslint-config-ordermentum": "1.0.6",
    "husky": "7.0.4",
    "lint-staged": "12.3.5",
    "mocha": "12.0.1",
    "mocha-sinon": "2.1.2",
    "nock": "13.5.5",
    "sinon": "13.0.1",
    "ts-node": "10.7.0",
    "ts-node-dev": "1.1.8",
    "typescript": "^4.9.5"
  },
  "scripts": {
    "build": "rm -rf build && tsc",
    "lint": "eslint '**/*.{ts,js}'",
    "spec": "NODE_ENV=test mocha -r ts-node/register/transpile-only 'test/**/*.{ts,js}'",
    "test": "yarn spec",
    "coverage": "nyc yarn spec",
    "typecheck": "yarn tsc --noEmit"
  },
  "dependencies": {
    "@ordermentum/asap-core": "*",
    "axios": "^1.19.0"
  },
  "nyc": {
    "extends": "@istanbuljs/nyc-config-typescript",
    "all": true,
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "**/*.d.ts",
      "**/build/**"
    ],
    "reporter": [
      "text-summary"
    ]
  }
}
